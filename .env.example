# Linchpin — environment variables used by docker-compose.yml
# Copy to .env and fill in the values:
#   cp .env.example .env

# Bearer token used to authenticate API requests (prefix: lpk_).
# Generate one with: openssl rand -hex 24
LINCHPIN_API_KEY=lpk_change_me

# Fernet key used to encrypt credentials at rest (vault).
# Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=change_me_fernet_key

# Model access — used by the API and (optionally) by the LiteLLM gateway profile.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Comma-separated list of allowed CORS origins for the console, e.g. http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Console → API base URL (only needed when the console is not served through the same origin).
# VITE_API_URL=http://localhost:8000

# LiteLLM gateway master key (only needed for `docker compose --profile litellm up`).
# LITELLM_MASTER_KEY=sk-linchpin
